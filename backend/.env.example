BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MASTER = main MikroTik: gateway, HotSpot, captive portal, RADIUS client.
MIKROTIK_MASTER_HOST=10.10.13.10
MIKROTIK_MASTER_USER=doorlink
MIKROTIK_MASTER_PASSWORD=change-me
MIKROTIK_MASTER_REST_SCHEME=http
MIKROTIK_MASTER_TIMEOUT=10

# Backward-compatible aliases for older code. Prefer MIKROTIK_MASTER_* above.
MIKROTIK_HOST=10.10.13.10
MIKROTIK_USER=doorlink
MIKROTIK_PASSWORD=change-me

# RADIUS CHR = User Manager server. DoorLink uses this for HotSpot user CRUD.
MIKROTIK_RADIUS_HOST=10.10.13.6
MIKROTIK_RADIUS_USER=admin
MIKROTIK_RADIUS_PASSWORD=change-me
MIKROTIK_RADIUS_REST_SCHEME=http
MIKROTIK_RADIUS_TIMEOUT=10
MIKROTIK_RADIUS_SYNC_ENABLED=true
MIKROTIK_RADIUS_AUTO_SYNC_ON_STARTUP=true

DATABASE_URL=sqlite:///doorlink.db
